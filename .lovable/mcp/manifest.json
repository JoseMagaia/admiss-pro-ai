          "required": [
            "lead_id",
            "note"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_company_settings",
        "title": "Update company settings",
        "description": "Patch company + branding fields on the caller's education_settings row. Only these keys are accepted: company_name, company_phone, company_email, office_address, working_hours, active_destinations, active_programs, scholarship_information, brand_name, brand_tagline, logo_light_url, logo_dark_url, logo_scale. Credentials (AI, Chatwoot, VoIP) must be changed through the UI.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "patch": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
