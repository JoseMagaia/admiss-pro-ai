      {
        "name": "create_lead",
        "title": "Create lead",
        "description": "Insert a new lead into the caller's active space. RLS enforces tenant scoping; the caller must belong to a space.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "lead_name": {
              "type": "string",
              "minLength": 1,
              "description": "Full name of the lead."
            },
            "phone_number": {
              "type": "string",
              "minLength": 3,
              "description": "WhatsApp-formatted phone (e.g. +2348012345678)."
            },
            "student_or_parent": {
              "type": "string",
              "enum": [
                "student",
                "parent"
              ]
            },
            "course_interest": {
              "type": "string"
            },
            "country_interest": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "space_id": {
              "type": "string",
              "format": "uuid",
              "description": "Target space. Defaults to the caller's first space."
            }
          },
          "required": [
            "lead_name",
            "phone_number"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_lead",
        "title": "Update lead",
        "description": "Patch editable fields on a lead. Unknown keys are ignored. Only lead_name, phone_number, student_or_parent, course_interest, country_interest, passport_status, academic_status, parent_phone, financial_alignment, parent_confirmation, document_received, qualification_status, notes are accepted.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid"
            },
            "patch": {
              "type": "object",
              "additionalProperties": {},
              "description": "Object of fields to update."
            }
          },
          "required": [
            "lead_id",
            "patch"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "set_lead_status",
        "title": "Set lead status",
        "description": "Change a lead's qualification_status (pipeline stage). Common values: new, contacted, engaged, qualified, unqualified, booked, enrolled, lost. Custom stages may exist — use list_pipeline_stages to discover them.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "New qualification_status value."
            },
            "note": {
              "type": "string",
              "description": "Optional note appended to the lead explaining the change."
            }
          },
          "required": [
            "lead_id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_lead_note",
        "title": "Add lead note",
        "description": "Append a timestamped note to a lead's notes field.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
